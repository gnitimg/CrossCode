{
  "name": "crosscode",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel -r dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop": "pnpm --filter @crosscode/desktop dev",
    "desktop:dist": "pnpm --filter @crosscode/web build && pnpm --filter @crosscode/desktop dist"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
